@model mist.ViewModels.EditReviewViewModel
@{
    ViewData["Title"] = "Edytuj recenzję";
}

<div class="container">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1><i class="bi bi-pencil-square"></i> Edytuj recenzję</h1>
        <a asp-controller="Games" asp-action="Details" asp-route-id="@Model.GameId" class="btn btn-secondary">
            <i class="bi bi-arrow-left"></i> Powrót
        </a>
    </div>

    <div class="row">
        <div class="col-md-8">
            <div class="card">
                <div class="card-header bg-primary text-white">
                    <h5 class="mb-0">Edytuj recenzję: @ViewBag.GameTitle</h5>
                </div>
                <div class="card-body">
                    <form asp-action="Edit" asp-route-id="@Model.Id" method="post">
                        @Html.AntiForgeryToken()
                        <input type="hidden" asp-for="GameId" />

                        <div asp-validation-summary="All" class="alert alert-danger"></div>

                        <!-- Ocena -->
                        <div class="mb-3">
                            <label asp-for="Rating" class="form-label">Ocena</label>
                            <input type="hidden" asp-for="Rating" id="Rating" />
                            <div class="star-rating" id="starRating">
                                <i class="bi bi-star star" data-value="1"></i>
                                <i class="bi bi-star star" data-value="2"></i>
                                <i class="bi bi-star star" data-value="3"></i>
                                <i class="bi bi-star star" data-value="4"></i>
                                <i class="bi bi-star star" data-value="5"></i>
                            </div>
                            <div class="rating-text text-muted small mt-1" id="ratingText">Wybierz ocenę</div>
                            <span asp-validation-for="Rating" class="text-danger"></span>
                        </div>

                        <!-- Tytuł -->
                        <div class="mb-3">
                            <label asp-for="Title" class="form-label">Tytuł recenzji</label>
                            <input asp-for="Title" class="form-control" />
                            <span asp-validation-for="Title" class="text-danger"></span>
                        </div>

                        <!-- Treść -->
                        <div class="mb-3">
                            <label asp-for="Content" class="form-label">Recenzja</label>
                            <textarea asp-for="Content" class="form-control" rows="6"></textarea>
                            <span asp-validation-for="Content" class="text-danger"></span>
                        </div>

                        <div class="d-grid gap-2 d-md-flex">
                            <button type="submit" class="btn btn-primary">
                                <i class="bi bi-check-circle"></i> Zapisz zmiany
                            </button>
                            <a asp-controller="Games" asp-action="Details" asp-route-id="@Model.GameId" 
                               class="btn btn-secondary">
                                Anuluj
                            </a>
                        </div>
                    </form>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card bg-light">
                <div class="card-header">
                    <h5 class="mb-0"><i class="bi bi-info-circle"></i> Informacje</h5>
                </div>
                <div class="card-body">
                    <p class="small mb-0">Możesz edytować swoją recenzję w dowolnym momencie.</p>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    .star-rating {
        display: flex;
        gap: 0.25rem;
        font-size: 2rem;
        cursor: pointer;
    }
    .star-rating .star {
        color: #ddd;
        transition: color 0.15s ease, transform 0.15s ease;
    }
    .star-rating .star:hover {
        transform: scale(1.1);
    }
    .star-rating .star.hovered,
    .star-rating .star.selected {
        color: #ffc107;
    }
    .star-rating .star.selected::before {
        content: "\F586";
    }
</style>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            const starRating = document.getElementById('starRating');
            const ratingInput = document.getElementById('Rating');
            const ratingText = document.getElementById('ratingText');
            const stars = starRating.querySelectorAll('.star');
            
            const ratingLabels = {
                1: '★ (1/5) - Słaba',
                2: '★★ (2/5) - Taka sobie',
                3: '★★★ (3/5) - Dobra',
                4: '★★★★ (4/5) - Bardzo dobra',
                5: '★★★★★ (5/5) - Doskonała'
            };
            
            let currentRating = parseInt(ratingInput.value) || 0;
            updateStars(currentRating);
            if (currentRating > 0) {
                ratingText.textContent = ratingLabels[currentRating];
            }
            
            stars.forEach(star => {
                star.addEventListener('mouseenter', function() {
                    const value = parseInt(this.dataset.value);
                    highlightStars(value);
                    ratingText.textContent = ratingLabels[value];
                });
                
                star.addEventListener('mouseleave', function() {
                    highlightStars(currentRating);
                    ratingText.textContent = currentRating > 0 ? ratingLabels[currentRating] : 'Wybierz ocenę';
                });
                
                star.addEventListener('click', function() {
                    currentRating = parseInt(this.dataset.value);
                    ratingInput.value = currentRating;
                    updateStars(currentRating);
                    ratingText.textContent = ratingLabels[currentRating];
                });
            });
            
            function highlightStars(rating) {
                stars.forEach(star => {
                    const value = parseInt(star.dataset.value);
                    star.classList.toggle('hovered', value <= rating);
                    if (value <= rating) {
                        star.classList.remove('bi-star');
                        star.classList.add('bi-star-fill');
                    } else if (!star.classList.contains('selected')) {
                        star.classList.remove('bi-star-fill');
                        star.classList.add('bi-star');
                    }
                });
            }
            
            function updateStars(rating) {
                stars.forEach(star => {
                    const value = parseInt(star.dataset.value);
                    star.classList.toggle('selected', value <= rating);
                    if (value <= rating) {
                        star.classList.remove('bi-star');
                        star.classList.add('bi-star-fill');
                    } else {
                        star.classList.remove('bi-star-fill');
                        star.classList.add('bi-star');
                    }
                });
            }
        });
    </script>
}

<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.0/font/bootstrap-icons.css">