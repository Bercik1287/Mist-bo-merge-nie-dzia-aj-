@model mist.Models.Game
@{
    ViewData["Title"] = "Edytuj grę: " + Model.Title;
    var allTags = ViewBag.AllTags as List<mist.Models.Tag> ?? new List<mist.Models.Tag>();
    var selectedTagIds = ViewBag.SelectedTagIds as List<int> ?? new List<int>();
}

<div class="container">
    <h1>Edytuj grę: @Model.Title</h1>

    <div class="row">
        <div class="col-md-8">
            <form asp-action="Edit" method="post" enctype="multipart/form-data">
                @Html.AntiForgeryToken()
                
                <input type="hidden" asp-for="Id" />
                <input type="hidden" asp-for="CreatedAt" />
                
                <div asp-validation-summary="All" class="text-danger mb-3"></div>

                <div class="mb-3">
                    <label asp-for="Title" class="form-label">Tytuł</label>
                    <input asp-for="Title" class="form-control" />
                    <span asp-validation-for="Title" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Description" class="form-label">Opis</label>
                    <textarea asp-for="Description" class="form-control" rows="5"></textarea>
                    <span asp-validation-for="Description" class="text-danger"></span>
                </div>

                <div class="row">
                    <div class="col-md-6">
                        <div class="mb-3">
                            <label asp-for="Price" class="form-label">Cena</label>
                            <input asp-for="Price" class="form-control" type="number" step="0.01" min="0.01" />
                            <span asp-validation-for="Price" class="text-danger"></span>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="mb-3">
                            <label class="form-label"><i class="bi bi-tags"></i> Tagi</label>
                            
                            <!-- Wyszukiwarka tagów -->
                            <div class="input-group mb-2">
                                <span class="input-group-text"><i class="bi bi-search"></i></span>
                                <input type="text" id="tagSearch" class="form-control" placeholder="Szukaj tagów...">
                            </div>
                            
                            <!-- Szybkie dodawanie tagu -->
                            <div class="input-group mb-2">
                                <input type="text" id="newTagName" class="form-control" placeholder="Nazwa nowego tagu...">
                                <button type="button" id="quickAddTagBtn" class="btn btn-outline-success">
                                    <i class="bi bi-plus-lg"></i> Dodaj
                                </button>
                            </div>
                            <div id="quickAddFeedback" class="small mb-2"></div>
                            
                            <div class="border rounded p-3" id="tagsContainer" style="max-height: 200px; overflow-y: auto;">
                                @if (allTags.Any())
                                {
                                    @foreach (var tag in allTags)
                                    {
                                        var isChecked = selectedTagIds.Contains(tag.Id);
                                        <div class="form-check tag-item" data-tag-name="@tag.Name.ToLower()">
                                            <input type="checkbox" name="selectedTagIds" value="@tag.Id" 
                                                   class="form-check-input" id="tag_@tag.Id" @(isChecked ? "checked" : "")>
                                            <label class="form-check-label" for="tag_@tag.Id">@tag.Name</label>
                                        </div>
                                    }
                                }
                                else
                                {
                                    <p class="text-muted mb-0 no-tags-message">Brak dostępnych tagów. Utwórz pierwszy tag powyżej.</p>
                                }
                            </div>
                            <small class="text-muted">Wybierz tagi pasujące do gry</small>
                        </div>
                    </div>
                </div>

                <div class="mb-3">
                    <label class="form-label">Obecne zdjęcie</label>
                    <div class="mb-2">
                        @if (!string.IsNullOrEmpty(Model.ImageUrl) && Model.ImageUrl != "/images/default-game.jpg")
                        {
                            <img src="@Model.ImageUrl" alt="Obecne zdjęcie" class="img-thumbnail" style="max-width: 300px; max-height: 300px;">
                            <div class="form-check mt-2">
                                <input type="checkbox" name="removeImage" class="form-check-input" id="removeImageCheck">
                                <label class="form-check-label text-danger" for="removeImageCheck">
                                    <i class="bi bi-trash"></i> Usuń obecne zdjęcie
                                </label>
                            </div>
                        }
                        else
                        {
                            <div class="alert alert-info">
                                <i class="bi bi-info-circle"></i> Nie przesłano jeszcze zdjęcia dla tej gry
                            </div>
                        }
                    </div>
                </div>

                <div class="mb-3">
                    <label class="form-label">Nowe zdjęcie gry (opcjonalnie)</label>
                    <input type="file" name="imageFile" class="form-control" accept="image/*" id="imageFileInput" />
                    <div class="form-text">
                        Dozwolone formaty: JPG, JPEG, PNG, GIF, WEBP. Maksymalny rozmiar: 5MB
                    </div>
                    <div id="imagePreview" class="mt-2" style="display: none;">
                        <p class="small text-muted">Nowy podgląd:</p>
                        <img id="previewImage" src="" alt="Podgląd" class="img-thumbnail" style="max-width: 300px; max-height: 300px;">
                    </div>
                </div>

                <div class="mb-3">
                    <label class="form-label"><i class="bi bi-download"></i> Obecny plik do pobrania</label>
                    <div class="mb-2">
                        @if (!string.IsNullOrEmpty(Model.DownloadUrl))
                        {
                            <div class="alert alert-success">
                                <i class="bi bi-file-earmark-check"></i> Plik do pobrania jest dostępny
                            </div>
                            <div class="form-check mt-2">
                                <input type="checkbox" name="removeDownloadFile" class="form-check-input" id="removeDownloadFileCheck">
                                <label class="form-check-label text-danger" for="removeDownloadFileCheck">
                                    <i class="bi bi-trash"></i> Usuń obecny plik do pobrania
                                </label>
                            </div>
                        }
                        else
                        {
                            <div class="alert alert-info">
                                <i class="bi bi-info-circle"></i> Nie przesłano jeszcze pliku do pobrania dla tej gry
                            </div>
                        }
                    </div>
                </div>

                <div class="mb-3">
                    <label class="form-label">Nowy plik gry do pobrania (opcjonalnie)</label>
                    <input type="file" name="downloadFile" class="form-control" accept=".zip,.rar,.7z,.exe,.msi" id="downloadFileInput" />
                    <div class="form-text">
                        Dozwolone formaty: ZIP, RAR, 7Z, EXE, MSI. Maksymalny rozmiar: 500MB
                    </div>
                    <div id="downloadFileInfo" class="mt-2" style="display: none;">
                        <span class="badge bg-success"><i class="bi bi-file-earmark-check"></i> <span id="downloadFileName"></span></span>
                    </div>
                </div>

                <div class="row">
                    <div class="col-md-6">
                        <div class="mb-3">
                            <label asp-for="Developer" class="form-label">Developer</label>
                            <input asp-for="Developer" class="form-control" />
                            <span asp-validation-for="Developer" class="text-danger"></span>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="mb-3">
                            <label asp-for="Publisher" class="form-label">Wydawca</label>
                            <input asp-for="Publisher" class="form-control" />
                            <span asp-validation-for="Publisher" class="text-danger"></span>
                        </div>
                    </div>
                </div>

                <div class="mb-3">
                    <label asp-for="ReleaseDate" class="form-label">Data wydania</label>
                    <input asp-for="ReleaseDate" class="form-control" type="date" 
                           value="@Model.ReleaseDate.ToString("yyyy-MM-dd")" />
                    <span asp-validation-for="ReleaseDate" class="text-danger"></span>
                </div>

                <div class="mb-3 form-check">
                    <input asp-for="IsActive" class="form-check-input" />
                    <label asp-for="IsActive" class="form-check-label">Gra aktywna</label>
                </div>

                <div class="d-grid gap-2 d-md-flex">
                    <button type="submit" class="btn btn-primary">Zapisz zmiany</button>
                    <a asp-action="Details" asp-route-id="@Model.Id" class="btn btn-secondary">Anuluj</a>
                </div>
            </form>
        </div>
        
        <div class="col-md-4">
            <div class="card bg-light">
                <div class="card-header">
                    <h5 class="mb-0"><i class="bi bi-info-circle"></i> Informacje</h5>
                </div>
                <div class="card-body">
                    <p><strong>ID gry:</strong> @Model.Id</p>
                    <p><strong>Data dodania:</strong> @Model.CreatedAt.ToString("dd.MM.yyyy HH:mm")</p>
                    <hr>
                    <p class="small text-muted mb-0">
                        <strong>Zarządzanie zdjęciem:</strong><br>
                        • Możesz przesłać nowe zdjęcie<br>
                        • Możesz usunąć obecne zdjęcie<br>
                        • Jeśli nie wybierzesz żadnej opcji, obecne zdjęcie zostanie zachowane
                    </p>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
    
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            // Podgląd obrazka przed przesłaniem
            var imageInput = document.getElementById('imageFileInput');
            if (imageInput) {
                imageInput.addEventListener('change', function(e) {
                    var file = e.target.files[0];
                    if (file) {
                        var reader = new FileReader();
                        reader.onload = function(e) {
                            document.getElementById('previewImage').src = e.target.result;
                            document.getElementById('imagePreview').style.display = 'block';
                        };
                        reader.readAsDataURL(file);
                        
                        // Jeśli wybrano nowy plik, odznacz opcję usunięcia
                        var removeCheck = document.getElementById('removeImageCheck');
                        if (removeCheck) removeCheck.checked = false;
                    } else {
                        document.getElementById('imagePreview').style.display = 'none';
                    }
                });
            }

            // Jeśli zaznaczono usunięcie, wyczyść input pliku
            var removeImageCheck = document.getElementById('removeImageCheck');
            if (removeImageCheck) {
                removeImageCheck.addEventListener('change', function() {
                    if (this.checked) {
                        document.getElementById('imageFileInput').value = '';
                        document.getElementById('imagePreview').style.display = 'none';
                    }
                });
            }

            // Podgląd pliku do pobrania
            var downloadInput = document.getElementById('downloadFileInput');
            if (downloadInput) {
                downloadInput.addEventListener('change', function(e) {
                    var file = e.target.files[0];
                    if (file) {
                        document.getElementById('downloadFileName').textContent = file.name + ' (' + (file.size / 1024 / 1024).toFixed(2) + ' MB)';
                        document.getElementById('downloadFileInfo').style.display = 'block';
                        
                        // Jeśli wybrano nowy plik, odznacz opcję usunięcia
                        var removeCheck = document.getElementById('removeDownloadFileCheck');
                        if (removeCheck) removeCheck.checked = false;
                    } else {
                        document.getElementById('downloadFileInfo').style.display = 'none';
                    }
                });
            }

            // Jeśli zaznaczono usunięcie pliku do pobrania, wyczyść input
            var removeDownloadCheck = document.getElementById('removeDownloadFileCheck');
            if (removeDownloadCheck) {
                removeDownloadCheck.addEventListener('change', function() {
                    if (this.checked) {
                        document.getElementById('downloadFileInput').value = '';
                        document.getElementById('downloadFileInfo').style.display = 'none';
                    }
                });
            }

            // Wyszukiwarka tagów
            var tagSearchInput = document.getElementById('tagSearch');
            if (tagSearchInput) {
                tagSearchInput.addEventListener('input', function(e) {
                    var searchTerm = e.target.value.toLowerCase();
                    var tagItems = document.querySelectorAll('.tag-item');
                    
                    for (var i = 0; i < tagItems.length; i++) {
                        var item = tagItems[i];
                        var tagName = item.getAttribute('data-tag-name');
                        if (tagName && tagName.indexOf(searchTerm) !== -1) {
                            item.style.display = '';
                        } else {
                            item.style.display = 'none';
                        }
                    }
                });
            }

            // Szybkie dodawanie tagu
            var quickAddBtn = document.getElementById('quickAddTagBtn');
            var newTagInput = document.getElementById('newTagName');
            
            if (quickAddBtn) {
                quickAddBtn.addEventListener('click', function() {
                    addNewTag();
                });
            }
            if (newTagInput) {
                newTagInput.addEventListener('keypress', function(e) {
                    if (e.key === 'Enter') {
                        e.preventDefault();
                        addNewTag();
                    }
                });
            }

            function addNewTag() {
                var input = document.getElementById('newTagName');
                var feedback = document.getElementById('quickAddFeedback');
                var tagName = input.value.trim();
                
                if (!tagName) {
                    feedback.innerHTML = '<span class="text-warning">Wprowadź nazwę tagu.</span>';
                    return;
                }
                
                feedback.innerHTML = '<span class="text-info"><i class="bi bi-hourglass-split"></i> Dodawanie...</span>';
                
                fetch('/Tags/QuickCreate', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json'
                    },
                    body: JSON.stringify({ name: tagName })
                })
                .then(function(response) {
                    if (!response.ok) {
                        if (response.status === 401 || response.status === 403) {
                            throw new Error('Brak uprawnień - zaloguj się jako Admin');
                        }
                        throw new Error('Błąd serwera: ' + response.status);
                    }
                    return response.json();
                })
                .then(function(data) {
                    if (data.success) {
                        // Dodaj nowy tag do listy
                        var container = document.getElementById('tagsContainer');
                        var noTagsMessage = container.querySelector('.no-tags-message');
                        if (noTagsMessage) {
                            noTagsMessage.remove();
                        }
                        
                        var newTagDiv = document.createElement('div');
                        newTagDiv.className = 'form-check tag-item';
                        newTagDiv.setAttribute('data-tag-name', data.name.toLowerCase());
                        newTagDiv.innerHTML = '<input type="checkbox" name="selectedTagIds" value="' + data.id + '" class="form-check-input" id="tag_' + data.id + '" checked><label class="form-check-label" for="tag_' + data.id + '">' + data.name + '</label>';
                        container.appendChild(newTagDiv);
                        
                        input.value = '';
                        feedback.innerHTML = '<span class="text-success"><i class="bi bi-check-circle"></i> Tag "' + data.name + '" został dodany i zaznaczony!</span>';
                        
                        // Schowaj feedback po 3 sekundach
                        setTimeout(function() { feedback.innerHTML = ''; }, 3000);
                    } else {
                        if (data.existingId) {
                            // Tag już istnieje - zaznacz go
                            var existingCheckbox = document.getElementById('tag_' + data.existingId);
                            if (existingCheckbox) {
                                existingCheckbox.checked = true;
                                feedback.innerHTML = '<span class="text-info"><i class="bi bi-info-circle"></i> Tag już istnieje - został zaznaczony.</span>';
                            } else {
                                feedback.innerHTML = '<span class="text-warning">' + data.message + '</span>';
                            }
                        } else {
                            feedback.innerHTML = '<span class="text-danger"><i class="bi bi-x-circle"></i> ' + data.message + '</span>';
                        }
                        setTimeout(function() { feedback.innerHTML = ''; }, 3000);
                    }
                    input.value = '';
                })
                .catch(function(error) {
                    feedback.innerHTML = '<span class="text-danger"><i class="bi bi-x-circle"></i> Wystąpił błąd podczas dodawania tagu.</span>';
                    console.error('Error:', error);
                });
            }
        });
    </script>
}