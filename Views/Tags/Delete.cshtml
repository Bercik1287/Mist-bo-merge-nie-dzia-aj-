@model mist.Models.Tag
@{
    ViewData["Title"] = "Usuń tag: " + Model.Name;
}

<div class="container">
    <h1 class="text-danger"><i class="bi bi-trash"></i> Usuń tag</h1>

    <div class="alert alert-warning">
        <h4 class="alert-heading"><i class="bi bi-exclamation-triangle"></i> Uwaga!</h4>
        <p>Czy na pewno chcesz usunąć tag <strong>"@Model.Name"</strong>?</p>
        <p class="mb-0">Ta operacja usunie tag ze wszystkich gier, do których jest przypisany.</p>
    </div>

    <div class="card mb-4">
        <div class="card-header">
            <h5 class="mb-0">Szczegóły tagu</h5>
        </div>
        <div class="card-body">
            <dl class="row mb-0">
                <dt class="col-sm-3">ID:</dt>
                <dd class="col-sm-9">@Model.Id</dd>

                <dt class="col-sm-3">Nazwa:</dt>
                <dd class="col-sm-9"><span class="badge bg-primary fs-6">@Model.Name</span></dd>

                <dt class="col-sm-3">Opis:</dt>
                <dd class="col-sm-9">@(Model.Description ?? "Brak opisu")</dd>

                <dt class="col-sm-3">Przypisane gry:</dt>
                <dd class="col-sm-9">
                    @if (Model.GameTags?.Any() == true)
                    {
                        <ul class="list-unstyled mb-0">
                            @foreach (var gameTag in Model.GameTags)
                            {
                                <li>• @gameTag.Game?.Title</li>
                            }
                        </ul>
                    }
                    else
                    {
                        <span class="text-muted">Brak przypisanych gier</span>
                    }
                </dd>
            </dl>
        </div>
    </div>

    <form asp-action="Delete" method="post">
        @Html.AntiForgeryToken()
        <input type="hidden" asp-for="Id" />
        
        <div class="d-grid gap-2 d-md-flex">
            <button type="submit" class="btn btn-danger">
                <i class="bi bi-trash"></i> Tak, usuń tag
            </button>
            <a asp-action="Index" class="btn btn-secondary">
                <i class="bi bi-x-circle"></i> Anuluj
            </a>
        </div>
    </form>
</div>

<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.0/font/bootstrap-icons.css">
