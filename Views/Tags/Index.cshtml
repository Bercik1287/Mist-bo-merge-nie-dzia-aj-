@model IEnumerable<mist.Models.Tag>
@{
    ViewData["Title"] = "Zarządzanie tagami";
}

<div class="container">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1><i class="bi bi-tags"></i> Zarządzanie tagami</h1>
        <div>
            <a asp-controller="Games" asp-action="Index" class="btn btn-outline-secondary me-2">
                <i class="bi bi-arrow-left"></i> Powrót do gier
            </a>
            <a asp-action="Create" class="btn btn-success">
                <i class="bi bi-plus-circle"></i> Dodaj nowy tag
            </a>
        </div>
    </div>

    @if (!Model.Any())
    {
        <div class="alert alert-info">
            <h4><i class="bi bi-info-circle"></i> Brak tagów</h4>
            <p>Nie utworzono jeszcze żadnych tagów. Kliknij przycisk powyżej, aby dodać pierwszy tag.</p>
        </div>
    }
    else
    {
        <div class="card">
            <div class="card-header">
                <h5 class="mb-0">Lista tagów (@Model.Count())</h5>
            </div>
            <div class="card-body">
                <table class="table table-striped table-hover">
                    <thead>
                        <tr>
                            <th>ID</th>
                            <th>Nazwa</th>
                            <th>Opis</th>
                            <th>Liczba gier</th>
                            <th>Akcje</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var tag in Model)
                        {
                            <tr>
                                <td>@tag.Id</td>
                                <td>
                                    <span class="badge bg-primary fs-6">@tag.Name</span>
                                </td>
                                <td>@(tag.Description ?? "-")</td>
                                <td>
                                    <span class="badge bg-info">@tag.GameTags?.Count gier</span>
                                </td>
                                <td>
                                    <div class="btn-group btn-group-sm">
                                        <a asp-action="Edit" asp-route-id="@tag.Id" class="btn btn-outline-primary">
                                            <i class="bi bi-pencil"></i> Edytuj
                                        </a>
                                        <a asp-action="Delete" asp-route-id="@tag.Id" class="btn btn-outline-danger">
                                            <i class="bi bi-trash"></i> Usuń
                                        </a>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
</div>

<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.0/font/bootstrap-icons.css">
