@model mist.Models.Tag
@{
    ViewData["Title"] = "Edytuj tag: " + Model.Name;
}

<div class="container">
    <h1><i class="bi bi-pencil"></i> Edytuj tag: @Model.Name</h1>

    <div class="row">
        <div class="col-md-6">
            <form asp-action="Edit" method="post">
                @Html.AntiForgeryToken()
                
                <input type="hidden" asp-for="Id" />
                
                <div asp-validation-summary="All" class="text-danger mb-3"></div>

                <div class="mb-3">
                    <label asp-for="Name" class="form-label">Nazwa tagu</label>
                    <input asp-for="Name" class="form-control" />
                    <span asp-validation-for="Name" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Description" class="form-label">Opis (opcjonalnie)</label>
                    <textarea asp-for="Description" class="form-control" rows="3"></textarea>
                    <span asp-validation-for="Description" class="text-danger"></span>
                </div>

                <div class="d-grid gap-2 d-md-flex">
                    <button type="submit" class="btn btn-primary">
                        <i class="bi bi-check-circle"></i> Zapisz zmiany
                    </button>
                    <a asp-action="Index" class="btn btn-secondary">
                        <i class="bi bi-x-circle"></i> Anuluj
                    </a>
                </div>
            </form>
        </div>

        <div class="col-md-6">
            <div class="card bg-light">
                <div class="card-header">
                    <h5 class="mb-0"><i class="bi bi-info-circle"></i> Informacje</h5>
                </div>
                <div class="card-body">
                    <p><strong>ID tagu:</strong> @Model.Id</p>
                    <p class="text-muted mb-0">
                        Zmiana nazwy tagu zostanie odzwierciedlona we wszystkich grach,
                        do których jest przypisany.
                    </p>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}

<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.0/font/bootstrap-icons.css">
